PORT=64567
PROTOCOL=https
# Public hostname of the API (HOSTNAME is still read as a fallback)
API_HOSTNAME=your.hostname.here
BASE_URL=/temp
HIDE_PORTS=true
# IN ms
SCRAPE_INTERVAL=15000
#CHART STUFF
CHART_SIZE=24
# IN ms
CHART_REFRESH_INTERVAL=15000
LOG_LEVEL=info
TEMP_FILE_PATH=/sys/class/thermal/thermal_zone2/temp
# Comma-separated origins allowed to call the API from a browser, or *
CORS_ALLOWED_ORIGINS=*
