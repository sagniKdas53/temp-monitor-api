{
  "name": "temp-api",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && node --watch index.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage test/*.test.js"
  },
  "author": "Sagnik Das",
  "license": "ISC",
  "description": "API that reads the CPU temperature from a Linux thermal zone file and serves it as JSON, Prometheus metrics and a Chart.js dashboard",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2"
  }
}
